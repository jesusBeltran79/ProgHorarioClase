@startuml clases_nucleo
!include estilo.iuml
skinparam nodesep 25
skinparam ranksep 40

title Núcleo del motor (paquetes sin Spring)

package "configuracion" {
  class ConfiguracionParametros {
    - capMax : int = 40
    - tol : double = 0.10
    - minCierre : int = 10
    - maxSesiones : int = 4
    - durSesionHoras : int = 2
    - aperturaSemana : LocalTime = 07:00
    - cierreSemana : LocalTime = 22:00
    - cierreSabado : LocalTime = 13:00
    - inicioBloqueo : LocalTime = 12:00
    - finBloqueo : LocalTime = 13:00
    + calcularUmbralMaximoGrupo() : int
    + generarFranjasValidas() : List<FranjaHoraria>
  }
}

package "motor" {
  class MotorAsignacion {
    - restricciones : List<RestriccionDura>
    - locales : List<RestriccionDura>
    - config : ConfiguracionParametros
    - limiteMs : long
    + MotorAsignacion(r : List<RestriccionDura>, cfg, limiteMs : long)
    + generarHorario(sesiones, docentes, aulas, franjas,\n    orden : OrdenExploracion, estadoIndexado : boolean) : ResultadoAsignacion
    - backtrack(idx : int, s : List<Sesion>, d, a, f, e : EstadoHorario) : boolean
    - cumpleTodas(c : Asignacion, e : EstadoHorario) : boolean
    - cumpleLocales(c : Asignacion) : boolean
    - buscarTuplaValida(s : Sesion, d, a, f, e : EstadoHorario) : Asignacion
    - diagnosticar(s : Sesion, d, a, f, e : EstadoHorario) : ReporteConflicto
  }
  class EstadoHorario {
    - confirmadas : List<Asignacion>
    - indexado : boolean
    - docentesPorFranja : List<Set<String>>
    - aulasPorFranja : List<Set<String>>
    - rechazosPorCodigo : Map<String, Integer>
    + agregarAsignacion(a : Asignacion) : void
    + removerUltimaAsignacion() : void
    + docenteOcupado(idDocente : String, franja : int) : boolean
    + aulaOcupada(idAula : String, franja : int) : boolean
    + registrarRechazo(s : Sesion, codigo : String) : void
    + getAsignaciones() : List<Asignacion>
  }
  class OrdenFranjas <<utilidad>> {
    + {static} intercalarDias(f : List<FranjaHoraria>) : List<FranjaHoraria>
  }
  enum OrdenExploracion {
    INGENUO
    MAS_RESTRINGIDA_PRIMERO
  }
  class ResultadoAsignacion <<record>> {
    completo : boolean
    agotoTiempo : boolean
    estado : EstadoHorario
    conflictos : List<ReporteConflicto>
    nodosExplorados : long
    evaluacionesDominioInicial : long
    msPreconteo : long
    msTotal : long
  }
  class ReporteConflicto <<record>> {
    idCurso : String
    idGrupo : String
    idSesion : String
    tuplasBloqueadasPorCodigo : Map<String, Integer>
    alternativasPorLiberacion : List<String>
    + codigosRestriccionesVioladas() : List<String>
  }
}

package "restricciones (Strategy)" {
  interface RestriccionDura <<interface>> {
    + getCodigo() : String
    + esLocal() : boolean
    + esValida(c : Asignacion, e : EstadoHorario, cfg : ConfiguracionParametros) : boolean
  }
  class RestriccionChoqueDocenteRD01 <<no local>>
  class RestriccionChoqueAulaRD02 <<no local>>
  class RestriccionDisponibilidadDocenteRD04 <<local>>
  class RestriccionIdoneidadAulaRD05 <<local>>
  class RestriccionCapacidadAulaRD06 <<local>>
  class RestriccionDocenteUnicoGrupoRD10 <<no local>>
  class RestriccionMismoDiaRD09 <<prueba de cambio>>
}

package "validacion" {
  class ValidadorEntrada {
    - reglas : List<ReglaValidacionEntrada>
    + validarGrupos(g : List<Grupo>, cfg : ConfiguracionParametros) : List<ReporteValidacion>
  }
  interface ReglaValidacionEntrada <<interface>> {
    + getCodigo() : String
    + validar(g : Grupo, cfg : ConfiguracionParametros) : Optional<ReporteValidacion>
  }
  class ReglaTopeMatriculadosRV01
  class ReglaCierreMinimoRV02
  class ReporteValidacion <<record>> {
    codigoRegla : String
    idGrupo : String
    mensaje : String
  }
}

MotorAsignacion o-- "1..*" RestriccionDura : evalúa
MotorAsignacion --> ConfiguracionParametros : lee
MotorAsignacion ..> EstadoHorario : crea
MotorAsignacion ..> ResultadoAsignacion : retorna
MotorAsignacion ..> OrdenExploracion
ResultadoAsignacion *-- "1" EstadoHorario
ResultadoAsignacion *-- "0..*" ReporteConflicto
RestriccionDura <|.. RestriccionChoqueDocenteRD01
RestriccionDura <|.. RestriccionChoqueAulaRD02
RestriccionDura <|.. RestriccionDisponibilidadDocenteRD04
RestriccionDura <|.. RestriccionIdoneidadAulaRD05
RestriccionDura <|.. RestriccionCapacidadAulaRD06
RestriccionDura <|.. RestriccionDocenteUnicoGrupoRD10
RestriccionDura <|.. RestriccionMismoDiaRD09
RestriccionDura ..> EstadoHorario : consulta
ValidadorEntrada o-- "1..*" ReglaValidacionEntrada
ReglaValidacionEntrada <|.. ReglaTopeMatriculadosRV01
ReglaValidacionEntrada <|.. ReglaCierreMinimoRV02
ReglaValidacionEntrada ..> ReporteValidacion : produce
ReglaTopeMatriculadosRV01 ..> ConfiguracionParametros : umbral
RestriccionChoqueDocenteRD01 -[hidden]down- RestriccionDisponibilidadDocenteRD04
RestriccionChoqueAulaRD02 -[hidden]down- RestriccionIdoneidadAulaRD05
RestriccionDocenteUnicoGrupoRD10 -[hidden]down- RestriccionCapacidadAulaRD06
RestriccionCapacidadAulaRD06 -[hidden]down- RestriccionMismoDiaRD09
OrdenFranjas -[hidden]down- OrdenExploracion
@enduml
