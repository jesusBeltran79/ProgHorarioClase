@startuml der
!include estilo.iuml
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam entityBackgroundColor #FFFFFF
skinparam entityBorderColor #1F4E79
hide empty members

entity "franja_horaria" as franja {
  * id_franja : SMALLINT <<PK>>
  --
  * dia : VARCHAR(10) <<CHECK>>
  * hora_inicio : TIME
  * hora_fin : TIME
  <<UNIQUE(dia, hora_inicio)>>
}
entity "docente" as docente {
  * id_docente : VARCHAR(10) <<PK>>
  --
  * nombre : VARCHAR(80)
  dedicacion : VARCHAR(20)
  escalafon : VARCHAR(30)
}
entity "disponibilidad_docente" as disp {
  * id_docente : VARCHAR(10) <<PK, FK>>
  * id_franja : SMALLINT <<PK, FK>>
}
entity "aula" as aula {
  * id_aula : VARCHAR(10) <<PK>>
  --
  * capacidad : SMALLINT <<CHECK mayor que 0>>
}
entity "caracteristica" as carac {
  * id_caracteristica : VARCHAR(20) <<PK>>
  --
  * descripcion : VARCHAR(60)
}
entity "aula_caracteristica" as aulac {
  * id_aula : VARCHAR(10) <<PK, FK>>
  * id_caracteristica : VARCHAR(20) <<PK, FK>>
}
entity "curso" as curso {
  * id_curso : VARCHAR(10) <<PK>>
  --
  * nombre : VARCHAR(80)
  * num_sesiones_semanales : SMALLINT <<CHECK 1..4>>
}
entity "curso_requisito_aula" as cursoreq {
  * id_curso : VARCHAR(10) <<PK, FK>>
  * id_caracteristica : VARCHAR(20) <<PK, FK>>
}
entity "habilitacion_docente" as habil {
  * id_curso : VARCHAR(10) <<PK, FK>>
  * id_docente : VARCHAR(10) <<PK, FK>>
}
entity "grupo" as grupo {
  * id_grupo : VARCHAR(15) <<PK>>
  --
  * id_curso : VARCHAR(10) <<FK>>
  * matriculados : SMALLINT <<CHECK mayor o igual a 0>>
}
entity "sesion" as sesion {
  * id_sesion : VARCHAR(20) <<PK>>
  --
  * id_grupo : VARCHAR(15) <<FK>>
  * numero_sesion : SMALLINT
  <<UNIQUE(id_grupo, numero_sesion)>>
}
entity "usuario" as usuario {
  * id_usuario : INTEGER <<PK>>
  --
  * nombre_usuario : VARCHAR(40) <<UNIQUE>>
  * hash_contrasena : CHAR(60)
  * rol : VARCHAR(15) <<CHECK = 'ADMIN'>>
}
entity "ejecucion_horario" as ejec {
  * id_ejecucion : INTEGER <<PK>>
  --
  * id_usuario : INTEGER <<FK>>
  * fecha_hora : TIMESTAMP
  * estado : VARCHAR(10) <<CHECK COMPLETO o PARCIAL>>
  * nodos_explorados : BIGINT
  * duracion_ms : INTEGER
}
entity "asignacion" as asig {
  * id_ejecucion : INTEGER <<PK, FK>>
  * id_sesion : VARCHAR(20) <<PK, FK>>
  --
  * id_docente : VARCHAR(10) <<FK>>
  * id_aula : VARCHAR(10) <<FK>>
  * id_franja : SMALLINT <<FK>>
  <<UNIQUE(id_ejecucion, id_docente, id_franja)>>
  <<UNIQUE(id_ejecucion, id_aula, id_franja)>>
}
entity "restriccion" as restr {
  * codigo : VARCHAR(6) <<PK>>
  --
  * tipo : VARCHAR(10) <<CHECK DURA o VALIDACION>>
  * descripcion : VARCHAR(120)
}
entity "conflicto" as confl {
  * id_conflicto : INTEGER <<PK>>
  --
  * id_ejecucion : INTEGER <<FK>>
  * id_sesion : VARCHAR(20) <<FK>>
  <<UNIQUE(id_ejecucion, id_sesion)>>
}
entity "conflicto_restriccion" as conflr {
  * id_conflicto : INTEGER <<PK, FK>>
  * codigo : VARCHAR(6) <<PK, FK>>
  --
  * tuplas_bloqueadas : INTEGER <<CHECK mayor que 0>>
}
entity "hallazgo_validacion" as hall {
  * id_ejecucion : INTEGER <<PK, FK>>
  * id_grupo : VARCHAR(15) <<PK, FK>>
  * codigo : VARCHAR(6) <<PK, FK>>
  --
  * mensaje : VARCHAR(200)
}
entity "parametro_configuracion" as param {
  * clave : VARCHAR(30) <<PK>>
  --
  * valor : VARCHAR(30)
  * tipo_dato : VARCHAR(10) <<CHECK>>
}

docente ||--o{ disp
franja ||--o{ disp
aula ||--o{ aulac
carac ||--o{ aulac
curso ||--o{ cursoreq
carac ||--o{ cursoreq
curso ||--o{ habil
docente ||--o{ habil
curso ||--|{ grupo
grupo ||--|{ sesion
usuario ||--o{ ejec
ejec ||--o{ asig
sesion ||--o{ asig
docente ||--o{ asig
aula ||--o{ asig
franja ||--o{ asig
ejec ||--o{ confl
sesion ||--o{ confl
confl ||--|{ conflr
restr ||--o{ conflr
ejec ||--o{ hall
grupo ||--o{ hall
restr ||--o{ hall
@enduml
