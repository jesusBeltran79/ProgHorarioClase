@startuml secuencia
!include estilo.iuml
skinparam sequenceParticipantBackgroundColor #DCE6F2
skinparam sequenceParticipantBorderColor #1F4E79
skinparam sequenceLifeLineBorderColor #7F7F7F
skinparam sequenceGroupBorderColor #7F7F7F
autonumber
actor "Coordinador\n(ADMIN)" as C
participant ":HorarioComponent\n(Angular)" as V
participant ":FiltroJwt" as F
participant ":ControladorHorarios" as K
participant ":ServicioHorarios" as S
participant ":RepositorioParametros\n:RepositorioInventarios" as RI
participant ":ValidadorEntrada" as VA
participant ":MotorAsignacion" as M
participant ":RestriccionDura" as R
participant ":EstadoHorario" as E
participant ":RepositorioEjecuciones" as RE

C -> V : clic en Generar horario
V -> F : POST /api/horarios/generar\nAuthorization: Bearer token
F -> F : ServicioJwt.validar(token)
alt token ausente, alterado o vencido
  F --> V : 401 NO_AUTENTICADO
else token válido con rol ADMIN
  F -> K : generar(autenticacion)
  K -> S : generar(nombreUsuario)
  S -> RI : cargar() parámetros e inventarios
  RI --> S : ConfiguracionParametros e InventarioCargado
  S -> S : generarFranjasValidas()\nConstructorDominio.construir()
  S -> VA : validarGrupos(grupos, cfg)
  VA --> S : List<ReporteValidacion> (RV-01, RV-02)
  S -> M : generarHorario(sesiones, docentes, aulas,\nOrdenFranjas.intercalarDias(franjas), MAS_RESTRINGIDA_PRIMERO, true)
  activate M
  M -> M : contar tuplas que pasan las reglas locales\ny ordenar sesiones por dominio
  loop backtracking por cada sesión y tupla candidata
    M -> R : esValida(candidata, estado, cfg)
    R -> E : docenteOcupado / aulaOcupada
    E --> R : resultado
    R --> M : true o false
    alt alguna regla responde false
      M -> E : registrarRechazo(sesión, código)
    else todas responden true
      M -> E : agregarAsignacion(candidata)
    end
  end
  opt se agota el árbol o el tiempo límite
    M -> M : diagnosticar(sesión pendiente)\ncuenta tuplas bloqueadas por código
  end
  M --> S : ResultadoAsignacion
  deactivate M
  S -> RE : guardar(idUsuario, completo, nodos, ms,\nasignaciones, conflictos, hallazgos)
  RE --> S : idEjecucion
  S --> K : Dto.Resultado (COMPLETO o PARCIAL)
  K --> V : 200 Resultado
  V --> C : grilla semanal, causas por código\ny alternativas (RF-07, RNF-04)
end
@enduml
