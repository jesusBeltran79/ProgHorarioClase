@startuml componentes
!include estilo.iuml
skinparam componentStyle uml2
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #1F4E79
skinparam packageBackgroundColor #FAFAFA
skinparam databaseBackgroundColor #FFFFFF

actor "Coordinador académico\n(perfil ADMIN)" as coord
actor "Docente\n(perfil DOCENTE)" as doc

package "Presentación · Angular 18.2" {
  [Páginas del ADMIN\nIngreso, Carga, Parametros, Horario\ncon arrastrar y soltar (Angular CDK)\nGestión de docentes, aulas,\nmaterias y usuarios] as pag
  [Portal del DOCENTE\nMi horario, Mi disponibilidad,\nMi cuenta] as portal
  [ApiService, GestionService, PortalService\nAutenticacionService e interceptor JWT\nguardiaRol por perfil] as apis
}

package "Aplicación · Spring Boot 3.3.5" {
  [ControladorInventarios\nControladorParametros\nControladorHorarios\nControladorCatalogos\nControladorUsuarios\nControladorPortal] as ctrl
  [ServicioInventarios\nServicioParametros\nServicioHorarios\nServicioCatalogos\nServicioCuentas\nServicioPortal] as serv
  [ConfiguracionMotor\ncatálogo de reglas] as ens
}

package "Seguridad" {
  [FiltroJwt y ServicioJwt\nJJWT 0.12.6, rol en el token] as jwt
  [ControladorAutenticacion\nbcrypt] as aut
}

package "Dominio · núcleo sin Spring" {
  [ValidadorEntrada\nRV-01, RV-02] as val
  [MotorAsignacion\ny EstadoHorario] as motor
  [Restricciones duras (Strategy)\nRD-01, RD-02, RD-04, RD-05, RD-06, RD-10] as rest
  [ConfiguracionParametros] as cfg
}

package "Persistencia" {
  [CargadorInventariosCSV\nExportadorHorarioCSV] as csv
  [Repositorios JDBC\nJdbcTemplate] as repo
  [Flyway\nV1 esquema, V2 datos base,\nV3 usuarios y publicación] as fly
}

database "PostgreSQL 16\n19 tablas" as db
folder "CSV de entrada\ny horario.csv" as arch

coord --> pag
doc --> portal
portal --> apis
pag --> apis
apis --> jwt : HTTP JSON con Bearer
jwt --> ctrl
apis --> aut : POST /api/auth/login
ctrl --> serv
serv --> val
serv --> motor
serv ..> ens
ens ..> rest
motor --> rest
motor --> cfg
serv --> csv
serv --> repo
csv --> arch
repo --> db
fly --> db
@enduml
